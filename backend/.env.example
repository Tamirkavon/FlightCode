# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-secure-random-string

# Database
DB_PATH=./flyai.db

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=FlyAI <your-email@gmail.com>

# Amadeus API (https://developers.amadeus.com - free tier available)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Price check cron schedule (default: every hour)
PRICE_CHECK_CRON=0 * * * *
